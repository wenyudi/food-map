# --- 复制为 .env 并填入真实值 ---

# 高德 Web 服务 API key（lbs.amap.com 申请）
AMAP_KEY=

# DeepSeek API key（platform.deepseek.com 申请）
DEEPSEEK_KEY=

# JWT 签名密钥：随便填一段长字符串，泄露了所有人能伪造登录
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 数据存储路径（容器内路径；宿主机用 volume 映射）
DATABASE_PATH=/data/food_map.db
PHOTOS_DIR=/data/photos

# 首次启动自动创建的管理员账号
INITIAL_ADMIN_USERNAME=aric
INITIAL_ADMIN_PASSWORD=change-me-immediately

# 服务端口（容器内监听端口，可不改）
PORT=8000

# --- 阿里云邮件推送（DirectMail）SMTP：注册 / 找回密码的邮箱验证码 ---
# 不配则进 dev 模式：验证码只记到服务器日志、不真发邮件
# 发信地址（= SMTP 认证用户名），邮件推送控制台「发信地址」里创建（类型选「触发邮件」）
MAIL_FROM=
# 该发信地址的 SMTP 密码（控制台「设置 SMTP 密码」，不是阿里云登录密码、不是 AccessKey）
MAIL_SMTP_PASSWORD=
# 收件人看到的发信人昵称
MAIL_FROM_NAME=饼饼の美食地图
# 服务器/端口一般不用改（国内默认；新加坡站点用 smtpdm-ap-southeast-1.aliyun.com）
# MAIL_SMTP_HOST=smtpdm.aliyun.com
# MAIL_SMTP_PORT=465
